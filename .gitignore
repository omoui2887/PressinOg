# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# ============================================================================
# SECRETS & CREDENTIALS — never commit (security hardening)
# ============================================================================
# Private keys / certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Credential & secret files (any name containing these keywords)
credentials*
secrets*
*.secret

# Env files (real secrets — never commit)
.env
.env.*
.env.local
.env.production
.env.staging
.env.development
# Exceptions: template files for other developers ARE committed
!.env.example
!.env.local.example
!.env.production.example

# Backup files (may contain old secrets)
*.bak
*.backup
*.old

# Git backup directories (contain full history with secrets)
.git-backup*

# ============================================================================
# DATABASES & DUMPS — never commit (may contain user data / hashes)
# ============================================================================
*.db
*.sqlite
*.sqlite3
*.dump
dump*.sql
*.sql.gz

# ============================================================================
# LOGS & TEMP FILES
# ============================================================================
# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

*.log
dev.log
dev.out.log
server.log

# Temp / swap files
*.tmp
*.swp
*.swo
*~

# Runtime process IDs (dev server state — never commit)
.zscripts/*.pid
*.pid

# ============================================================================
# FRAMEWORK / BUILD ARTIFACTS
# ============================================================================
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next.js
/.next/
/out/

# production
/build

# testing
/coverage

# local config
local-*
.claude
.z-ai-config
test
prompt

# ============================================================================
# PROJECT-SPECIFIC (e-pressing / OgPressing)
# ============================================================================
# Skills directory (third-party tooling, not app code)
/skills/

# Private user uploads (PRD, specs, screenshots) — never commit
/upload/
/screenshots/
/agent-ctx/

# Worklog contains developer notes that may include credentials/secrets — never commit
worklog.md

# Tool result artifacts
tool-results/

# Test/verification screenshots (root-level, auto-generated by agent-browser)
/*.png
/*.jpg
/*.jpeg
/*.webp

# Default env values (contains real secrets — never commit)
.env.defaults
