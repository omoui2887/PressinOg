# ============================================================================
# OgPressing — Modèle de variables d'environnement DÉVELOPPEMENT LOCAL
# ----------------------------------------------------------------------------
# 1. Copiez ce fichier vers `.env.local` :
#       cp .env.local.example .env.local
# 2. Remplissez les valeurs avec les clés de VOTRE projet Supabase
#    (Dashboard → Project Settings → API).
# 3. ⚠️  `.env.local` est ignoré par .gitignore — ne le committer JAMAIS.
# 4. Relancez `bun run dev` pour que Next.js charge les nouvelles variables.
# ============================================================================

# ----------------------------------------------------------------------------
# 1) URL publique du projet Supabase (votre projet de dev/test)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# ----------------------------------------------------------------------------
# 2) Clé ANON (publique) — exposée au navigateur, protégée par RLS
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY

# ----------------------------------------------------------------------------
# 3) ⚠️  Clé SERVICE ROLE — SERVEUR UNIQUEMENT
#    Ne JAMAIS utiliser le préfixe NEXT_PUBLIC_ pour cette variable.
#    Utilisée par src/lib/supabase/admin.ts (getSupabaseAdmin) dans les
#    route handlers server-side UNIQUEMENT.
# ----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY

# ----------------------------------------------------------------------------
# 4) URL du site en local (utilisée pour les e-mails d'invitation du
#    personnel — liens de connexion). En dev, laissez localhost:3000.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# 5) (Optionnel mais recommandé) Secret de signature du cookie de cache de
#    rôle côté Edge Middleware. Voir .env.production.example pour le détail.
#    En dev, peut rester vide (fallback sur la clé anon Supabase).
# ----------------------------------------------------------------------------
OGP_ROLE_CACHE_SECRET=

# ----------------------------------------------------------------------------
# 6) (Scaffold Prisma uniquement) En local, le projet embarque une base
#    SQLite de démonstration sous `db/custom.db`. Prisma n'est PAS utilisé
#    par le code runtime (Supabase est la source de vérité en prod), mais
#    le fichier `prisma/schema.prisma` référence DATABASE_URL via env().
#    Laissez la valeur par défaut pour que `bun run db:push` fonctionne.
# ----------------------------------------------------------------------------
DATABASE_URL=file:./db/custom.db
